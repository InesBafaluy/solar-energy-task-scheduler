# schedule.py : agenda du refuge avec OR-Tools (CP-SAT) 
import os                                        # chemins de fichiers (notebook 1)
import json                                      # lecture de system.json
import numpy as np                               # tableaux numpy (notebook 4)
import pandas as pd                              # tableaux pandas (notebook 9)
import plotly.express as px                      # graphique interactif (notebook 10)
from ortools.sat.python import cp_model          # solveur OR-Tools

DATA, OUT = os.path.join("data", "sample"), "outputs"   # dossiers d'entrée et de sortie (affectation multiple)


#Calcul des horaires par le solveur 
def to_min(hhmm):                                # "08:30" -> 510 (minutes depuis minuit)
    h, m = hhmm.split(":")                       # split : coupe la chaîne sur ":" (notebook 2)
    return int(h) * 60 + int(m)                  # conversion de type int() (notebook 2)


#Inverse de la fonction précédente, encoder les heures pour la lecture de l'agenda
def to_hhmm(mn):                                 # 510 -> "08:30"
    return f"{mn // 60:02d}:{mn % 60:02d}"       # f-string, division entière // et modulo % (notebooks 1 et 2)


#Cette fonction lit les trois fichiers d'entrée (paramètres du système, prévision horaire de la journée choisie, liste des tâches), 
#puis ajoute au tableau des tâches les colonnes utiles au solveur : si la tâche est déjà réalisée, son heure de début au plus tôt et au plus tard 
#(imposée ou calculée à partir de la fenêtre horaire), et son énergie en kWh
def load_data(scenario="sunny"):                 # argument par défaut (notebook 7)
    with open(os.path.join(DATA, "system.json"), encoding="utf-8") as f:   # ouvre le fichier du système
        system = json.load(f)                    # dictionnaire des paramètres (notebook 2)
    forecast = pd.read_csv(os.path.join(DATA, f"forecast_{scenario}.csv"))   # prévision horaire
    t = pd.read_csv(os.path.join(DATA, "tasks.csv"))   # liste des tâches
    t["forced"] = t["forced_start"].notna()      # colonne booléenne : tâche déjà réalisée ?
    fm = t["forced_start"].map(to_min, na_action="ignore")   # .map : minute imposée (NaN si tâche libre)
    t["lo"] = np.where(t["forced"], fm, t["earliest_start"].map(to_min))   # début au plus tôt (np.where, notebook 4)
    t["hi"] = np.where(t["forced"], fm, t["deadline"].map(to_min) - t["duration_min"])   # début au plus tard
    t["energy_kwh"] = t["power_kw"] * t["duration_min"] / 60   # énergie de la tâche (calcul sur toute la colonne)
    return system, forecast, t                   # renvoie trois objets (tuple)


#Cette fonction convertit les unités (kW -> W, kWh -> W·min) pour les paramètres du système et la prévision horaire
def to_watts(system, forecast):                  # conversion des unités (le solveur ne gère que des entiers)
    W = {k: int(v * 1000) for k, v in system.items() if k.endswith("_kw")}   # dictionnaire : kW -> W
    E = {k: int(v * 60000) for k, v in system.items() if k.endswith("_kwh") and not isinstance(v, dict)}   # kWh -> W·min
    pv = (forecast["pv_kw"] * 1000).round().astype(int).tolist()   # production solaire par heure (W)
    base = (forecast["base_load_kw"] * 1000).round().astype(int).tolist()   # consommation de base par heure (W)
    return W, E, pv, base                        # renvoie quatre objets (tuple)


#Cette fonction crée les variables du solveur pour chaque tâche : une variable entière pour la minute de départ, 
#une variable booléenne pour savoir si la tâche est planifiée ou non, un bloc continu (intervalle) non interruptible, et la puissance demandée par ce bloc
def add_tasks(mdl, use):                         # une variable « minute de démarrage » par tâche
    S, P, iv, dem = {}, {}, [], []               # dictionnaires (départs, présence) et listes (blocs, puissances)
    for t in use.itertuples():                   # boucle for sur chaque tâche (notebook 5)
        S[t.task_id] = mdl.NewIntVar(int(t.lo), int(t.hi), "")   # variable : minute de démarrage
        P[t.task_id] = mdl.NewConstant(1) if t.forced else mdl.NewBoolVar("")   # planifiée (1) ou non (0)
        iv.append(mdl.NewOptionalFixedSizeIntervalVar(S[t.task_id], int(t.duration_min), P[t.task_id], "")) # bloc continu : non interruptible
        dem.append(int(round(t.power_kw * 1000)))   # puissance demandée par ce bloc
    return S, P, iv, dem                         # départs, présence, blocs, puissances


#Cette fonction crée les contraintes de puissance : à chaque heure, la somme des puissances demandées 
#par les tâches planifiées ne doit pas dépasser la puissance disponible (onduleur, solaire, batterie, groupe électrogène)
def add_power(mdl, iv, dem, gen, pv, base, inv, batt): # limite de puissance, heure par heure
    for h in range(24):                          # pour chacune des 24 heures
        avail = mdl.NewIntVar(0, inv, "")        # puissance disponible pour les tâches
        mdl.AddMinEquality(avail, [inv - base[h], max(0, pv[h] + batt - base[h]) + gen[h]])   # min(onduleur, solaire + batterie + groupe)
        blocked = mdl.NewIntVar(0, inv, "")      # puissance NON disponible
        mdl.Add(blocked == inv - avail)          # = onduleur - disponible
        iv.append(mdl.NewFixedSizeIntervalVar(60 * h, 60, ""))   # faux bloc d'une heure qui « réserve » cette puissance
        dem.append(blocked)                      # sa demande = la puissance bloquée
    mdl.AddCumulative(iv, dem, inv)              # à chaque minute : somme des puissances <= onduleur


#Cette fonction calcule l'énergie consommée par les tâches planifiées pendant une heure donnée h
def task_energy(mdl, use, S, P, h):              # énergie consommée par les tâches pendant l'heure h
    used = []                                    # liste des énergies, une par tâche
    for t in use.itertuples():                   # pour chaque tâche utilisable
        if t.hi + t.duration_min <= 60 * h or t.lo >= 60 * h + 60:   # tâche qui ne peut pas toucher cette heure
            continue                             # on passe à la suivante (continue, notebook 5)
        end, beg, ov, ove = [mdl.NewIntVar(0, 1500, "") for _ in range(4)]   # fin coupée, début coupé, minutes dans l'heure, idem si planifiée
        mdl.AddMinEquality(end, [S[t.task_id] + int(t.duration_min), 60 * h + 60])   # min(fin, fin d'heure)
        mdl.AddMaxEquality(beg, [S[t.task_id], 60 * h])   # max(début, début d'heure)
        mdl.AddMaxEquality(ov, [end - beg, 0])   # minutes dans l'heure h (jamais négatif)
        mdl.Add(ove == ov).OnlyEnforceIf(P[t.task_id])   # tâche planifiée : on compte
        mdl.Add(ove == 0).OnlyEnforceIf(P[t.task_id].Not())   # tâche non planifiée : 0
        used.append(int(round(t.power_kw * 1000)) * ove)   # énergie = puissance x minutes
    return sum(used)                             # énergie totale des tâches dans l'heure h


#Cette fonction crée les contraintes de niveau de batterie : à chaque heure, le niveau de batterie est calculé à partir du niveau précédent,
#de la production solaire, de la consommation de base, de la production du groupe électrogène et de l'énergie consommée par les tâches planifiées
def add_battery(mdl, use, S, P, gen, pv, base, soc0, cap, reserve, target):  # niveau de batterie
    prev = min(int(soc0 * 60000), cap)           # niveau de batterie au départ
    for h in range(24):                          # heure après heure
        raw, cur = mdl.NewIntVar(-10**9, 10**9, ""), mdl.NewIntVar(0, cap, "")   # niveau avant plafonnement, niveau réel
        mdl.Add(raw == prev + 60 * (pv[h] - base[h] + gen[h]) - task_energy(mdl, use, S, P, h))   # bilan : + solaire + groupe - base - tâches
        mdl.AddMinEquality(cur, [raw, cap])      # plafonné à la capacité (le surplus est perdu)
        mdl.Add(cur >= reserve)                  # jamais sous la réserve minimale
        prev = cur                               # point de départ de l'heure suivante
    mdl.Add(prev >= target)                      # niveau minimal en fin de journée


#Cette fonction assemble le modèle, lance le solveur et renvoie l'agenda des tâches planifiées, la production du groupe électrogène par heure et le statut du solveur
def solve(system, forecast, tasks, soc0, time_limit=20):   # assemble le modèle et lance le solveur
    W, E, pv, base = to_watts(system, forecast)  # unités converties
    mdl = cp_model.CpModel()                     # le modèle : variables + contraintes + objectif
    use = tasks[tasks["hi"] >= tasks["lo"]]      # filtre booléen : on écarte les tâches dont la fenêtre est trop courte
    S, P, iv, dem = add_tasks(mdl, use)          # variables des tâches
    gen = [mdl.NewIntVar(0, W["genset_derated_kw"], "") for _ in range(24)]   # liste en compréhension (notebook 7) : groupe par heure, 12 kW max à 2 500 m
    mdl.Add(sum(gen) <= int(system["genset_max_kwh_per_day"] * 1000))   # budget carburant de la journée
    add_power(mdl, iv, dem, gen, pv, base, W["inverter_max_kw"], W["battery_max_discharge_kw"])   # contraintes de puissance
    add_battery(mdl, use, S, P, gen, pv, base, soc0, E["battery_capacity_kwh"], E["battery_reserve_kwh"], E["end_of_day_soc_target_kwh"])   # contraintes de batterie
    mdl.Maximize(sum(100000 * int(t.priority) * P[t.task_id] for t in use.itertuples())   # 1) priorités des tâches planifiées
                 - 10 * sum(gen) - sum(S.values()))   # 2) moins de groupe électrogène, 3) départs tôt
    solver = cp_model.CpSolver()                 # le solveur
    solver.parameters.max_time_in_seconds = time_limit   # temps maximum
    solver.parameters.relative_gap_limit = 0.0001   # arrêt à 0,01 % de l'optimum
    status = solver.StatusName(solver.Solve(mdl))   # résolution, puis nom du statut
    if status not in ("OPTIMAL", "FEASIBLE"):   # aucun agenda trouvé
        return None, None, status                # on le signale
    plan = {k: solver.Value(S[k]) for k in S if solver.Value(P[k])}   # dict : tâche planifiée -> minute de départ
    return plan, [solver.Value(g) for g in gen], status   # agenda, groupe par heure, statut


#VERIFICATION : cette fonction vérifie indépendamment du solveur que l'agenda est correct : puissance disponible, niveau de batterie, objectif de fin de journée
def check(tasks, plan, gen, forecast, system, soc0):   # vérification INDÉPENDANTE du solveur (numpy)
    load = np.zeros(1440)                        # puissance des tâches minute par minute (notebook 4)
    for t in tasks.itertuples():                 # pour chaque tâche
        if t.task_id in plan:                    # si elle est planifiée
            load[plan[t.task_id]:plan[t.task_id] + t.duration_min] += t.power_kw   # slicing : on ajoute sa puissance sur ses minutes
    by_hour = load.reshape(24, 60)               # 24 heures x 60 minutes (notebook 4)
    pv, base, g = forecast["pv_kw"].to_numpy(), forecast["base_load_kw"].to_numpy(), np.array(gen) / 1000   # tableaux numpy (kW)
    avail = np.minimum(system["inverter_max_kw"] - base, pv + system["battery_max_discharge_kw"] - base + g)   # puissance disponible
    kwh, cap, soc, socs = by_hour.sum(axis=1) / 60, system["battery_capacity_kwh"], soc0, []   # énergie des tâches par heure, capacité, niveau
    for i in range(24):                          # heure par heure
        soc = min(cap, soc + pv[i] + g[i] - base[i] - kwh[i])   # bilan de l'heure
        socs.append(soc)                         # on mémorise le niveau
    problems = [msg for ok, msg in [((by_hour.max(axis=1) <= avail + 1e-6).all(), "puissance dépassée"),   # tableau booléen + .all() (notebook 4)
                                    (min(socs) >= system["battery_reserve_kwh"] - 1e-6, "batterie sous la réserve"),   # réserve respectée ?
                                    (socs[-1] >= system["end_of_day_soc_target_kwh"] - 1e-6, "objectif de fin de journée manqué")]   # objectif atteint ?
                if not ok]                       # on garde seulement les tests échoués
    hourly = pd.DataFrame({"hour": range(24), "pv_kw": pv, "base_kw": base, "genset_kw": g, "tasks_kwh": kwh, "soc_kwh": socs}).round(3)   # bilan horaire pandas
    return hourly.merge(forecast[["hour", "cloud_cover_pct"]], on="hour"), problems   # .merge : ajoute la nébulosité (clé "hour")


#Cette fonction construit le tableau pandas de l'agenda à partir des tâches et du plan trouvé par le solveur
def build_agenda(tasks, plan):                   # tableau pandas de l'agenda
    agenda = tasks.assign(start_min=tasks["task_id"].map(plan))   # .assign + .map(dict) : minute de départ, NaN si non planifiée
    agenda["status"] = np.where(agenda["start_min"].notna(), "planifiée", "NON planifiée")   # np.where : texte selon que la tâche est planifiée ou non
    agenda["start"] = agenda["start_min"].map(lambda s: to_hhmm(int(s)), na_action="ignore")   # heure de début "HH:MM"
    agenda["end"] = (agenda["start_min"] + agenda["duration_min"]).map(lambda e: to_hhmm(int(e)), na_action="ignore")   # heure de fin
    cols = ["task_id", "name", "priority", "status", "start", "end", "power_kw", "energy_kwh", "forced"]   # colonnes utiles
    return agenda[cols].sort_values(["status", "start"], ascending=[False, True])   # planifiées d'abord, puis par heure


#Cette fonction enregistre les fichiers CSV de l'agenda et du bilan horaire, puis crée un graphique interactif pour visualiser l'agenda
def save_results(agenda, hourly, scenario):      # enregistre les CSV et le graphique
    os.makedirs(OUT, exist_ok=True)              # crée le dossier outputs s'il n'existe pas
    agenda.to_csv(os.path.join(OUT, f"agenda_{scenario}.csv"), index=False)   # agenda en CSV
    hourly.to_csv(os.path.join(OUT, f"hourly_{scenario}.csv"), index=False)   # bilan horaire en CSV
    done = agenda[agenda["status"] == "planifiée"].copy()   # filtre booléen : tâches planifiées
    for c, src in [("Début", "start"), ("Fin", "end")]:   # boucle sur deux colonnes (notebook 5)
        done[c] = pd.to_datetime("2026-01-01 " + done[src])   # plotly veut des dates : jour fictif + heure
    fig = px.timeline(done, x_start="Début", x_end="Fin", y="name", color="forced", title=f"Agenda : journée {scenario}")   # Gantt interactif
    fig.update_yaxes(autorange="reversed").write_html(os.path.join(OUT, f"agenda_{scenario}.html"))   # première tâche en haut, puis sauvegarde en HTML


#Cette fonction affiche dans le terminal l'agenda complet, le nombre de tâches et l'énergie par statut, la liste des tâches non planifiées, 
#la consommation du groupe électrogène et le niveau final de la batterie, ainsi que le résultat de la vérification indépendante
def show(agenda, tasks, plan, gen, hourly, problems):   # affichage dans le terminal
    print(agenda.to_string(index=False))         # agenda complet
    print(agenda.groupby("status")["energy_kwh"].agg(["count", "sum"]).round(1))   # .groupby + .agg : nombre de tâches et énergie par statut
    print(f"Non planifiées : {sorted(set(tasks['task_id']) - set(plan))} | groupe : {sum(gen) / 1000:.1f} kWh | batterie fin : {hourly['soc_kwh'].iloc[-1]:.1f} kWh")   # différence de sets (notebook 2) + f-string
    print("Vérification indépendante :", "OK" if not problems else problems)   # résultat du contrôle


#Cette fonction enchaîne toutes les étapes : lecture des entrées, résolution du problème, construction de l'agenda, 
#vérification indépendante, sauvegarde des résultats et affichage
def run(scenario="sunny", **options):            # PARTIE 4 : enchaîne toutes les étapes ; **options : ex. time_limit=10 (notebook 7)
    system, forecast, tasks = load_data(scenario)   # lecture des entrées
    soc0 = system["initial_soc_kwh"][scenario]   # batterie au début de la journée
    plan, gen, status = solve(system, forecast, tasks, soc0, **options)   # ** : on transmet les options au solveur
    print(f"\n=== {scenario} | batterie initiale {soc0} kWh | solveur : {status} ===")   # titre
    if plan is None:                             # pas d'agenda possible
        return print("Aucun agenda possible : vérifier les tâches déjà réalisées.")   # message, puis on s'arrête
    agenda = build_agenda(tasks, plan)           # tableau de l'agenda
    hourly, problems = check(tasks, plan, gen, forecast, system, soc0)   # vérification indépendante
    save_results(agenda, hourly, scenario)       # fichiers CSV et graphique
    show(agenda, tasks, plan, gen, hourly, problems)   # affichage

#Cette partie est exécutée seulement si on lance ce fichier directement
if __name__ == "__main__":                       # exécuté seulement si on lance ce fichier directement
    for sc in ["sunny", "cloudy"]:               # les deux journées test
        run(sc, time_limit=20)                   # lancement avec 20 s maximum